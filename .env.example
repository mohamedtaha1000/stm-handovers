# Copy this file to .env (or set these as real environment variables on
# your hosting platform) and fill in real values before deploying.

# A random long string used to sign login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-value

# The very first Admin account. Only used once, the first time the app
# starts with no accounts at all - after that, manage every account from
# "Manage users" while signed in as an Admin. Safe to leave set or
# remove afterwards; it does nothing once any account exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-too
ADMIN_DISPLAY_NAME=Admin

# What every account an Admin creates (or resets) starts with - never a
# password the Admin picks per person, always this one value, because
# the person is required to replace it with something only they know
# the moment they log in. Optional; defaults to Abc@123456789.
# DEFAULT_USER_PASSWORD=

# Optional: only needed if you want the history database to live
# somewhere other than the default local SQLite file (e.g. a managed
# Postgres database URL your host gives you).
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Who the "this has been handed over" email is addressed to. Leave it
# unset and the draft still opens in Outlook, just with an empty To line
# for you to fill in.
HANDOVER_NOTIFY_TO=
HANDOVER_NOTIFY_NAME=Eng. Hegazy

# Who each of the two "someone is leaving" emails is addressed to. The
# EMS one asks for the FortiClient deactivation code; the resignation
# one tells the team the person has gone. Either left blank just means
# that message opens with an empty To line.
HANDOVER_EMS_TO=
HANDOVER_LEAVER_TO=

# Where the laptop register spreadsheet is written. It is rebuilt from
# the database every time a document is generated, edited or deleted, and
# every time someone is marked as having left. Default: laptop_register.xlsx
# beside the app.
# HANDOVER_REGISTER_PATH=

# Whether the app may open drafts in Outlook itself, where the employee
# and equipment details arrive as tables, rather than handing the browser
# a mailto: link, which can only carry plain text.
#
#   auto   (default) only when the page is opened from this same machine
#   always also when it is reached by this machine's own name or IP,
#          which "auto" cannot tell apart from a colleague's browser -
#          only correct when the app is used from the machine it runs on
#   never  always use the mailto: link
#
# This also needs the pywin32 package (pip install pywin32) and classic
# desktop Outlook. When it cannot be used, the buttons say why and fall
# back to the mailto: link on their own.
HANDOVER_OUTLOOK=auto
